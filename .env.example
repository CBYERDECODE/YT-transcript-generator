# Browser-safe values (Vite embeds these in the client build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web: leave empty (uses relative /api routes). Desktop: your Vercel production URL.
VITE_API_BASE_URL=

# Desktop only: Supabase email-confirm redirect (register in Supabase Auth → URL Configuration)
VITE_AUTH_REDIRECT_URL=cliptext://auth/callback

# Desktop build target flag (set to "desktop" in .env.desktop)
VITE_APP_TARGET=

# GitHub Releases page for download buttons on the web app
VITE_GITHUB_RELEASES_URL=https://github.com/your-org/cliptext/releases/latest

# Server-only secrets. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APIFY_API_TOKEN=your-apify-api-token
APIFY_ACTOR_ID=automation-lab/youtube-transcript
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
